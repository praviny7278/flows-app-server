# API port
PORT=4000

# Allowed browser origin for CORS
WEB_ORIGIN=http://localhost:3000

NODE_ENV=development

# Redis powers the rate limiter, session cache, and page-view queue.
# Leave unset to fail open (no rate limiting, no caching).
REDIS_URL=redis://localhost:6379

# MongoDB connection string.
# Pool sizing: the MongoDB driver default maxPoolSize is 100 per process.
# When running N replicas/cluster workers, divide the database connection
# budget between them, e.g. ?maxPoolSize=50 for 2 instances on Atlas Flex (500 limit).
DATABASE_URL=mongodb://localhost:27017/flowops

# Optional: password recovery emails via Resend
RESEND_API_KEY=
EMAIL_FROM=

# Seed/demo only
SUPER_ADMIN_EMAIL=

# ===== Logging =====
# debug | info | warn | error | silent
LOG_LEVEL=debug
# Set to "off" to silence per-request HTTP logs
HTTP_LOG=on
# Set to "true" to also append logs to LOG_DIR/flowops-server-YYYY-MM-DD.log
LOG_TO_FILE=false
LOG_DIR=logs
